# =====================================================================
# NeuroSense AI — Single Consolidated Environment Configuration Template
# =====================================================================
# Copy this file to `.env` in the project root (`d:\neurosense-ai\.env`).
# Both frontend and backend can load configuration directly from root `.env`.
# NEVER commit the actual `.env` file containing secret keys to GitHub.
# =====================================================================

# ─── Flask Backend ───────────────────────────────────────────────────
PORT=10000
SECRET_KEY=neurosense-secure-jwt-secret-key-2026-prod
FLASK_ENV=development
LOG_LEVEL=INFO

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

# ─── Frontend ────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:10000
# Enable Demo Mode (100% offline, zero network requests, synthetic data)
VITE_DEMO_MODE=true

# ─── Multi-Provider AI Recommender Keys (Auto-Failover Enabled) ──────
# Option 1: Google Gemini API Key (Free tier via Google AI Studio)
GEMINI_API_KEY=

# Option 2: Groq API Key (Free ultra-fast Llama 3 API via groq.com)
GROQ_API_KEY=

# Option 3: OpenAI API Key (Commercial GPT-4o / GPT-3.5-Turbo via openai.com)
OPENAI_API_KEY=
