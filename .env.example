# NeuroSense AI - Unified Environment Configuration (Docker + Bare-Metal)
# Copy this file to `.env` in the project root and fill in your values:
#   cp .env.example .env

# ── Core Security & App Mode ─────────────────────────────────────────────────
# Set to "production" on live servers (disables demo seeding & Swagger /docs)
APP_ENV=development
# Generate a strong random secret for production: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret
PORT=10000
LOG_LEVEL=INFO
TRUST_PROXY=true
EXPOSE_RESET_TOKEN=false

# ── Database (PostgreSQL for Docker; bare-metal falls back to SQLite) ────────
POSTGRES_USER=neuro
POSTGRES_PASSWORD=neuro
POSTGRES_DB=neurosense

# ── Web & CORS ───────────────────────────────────────────────────────────────
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://neurosense.duckdns.org,https://neurosense-ai.duckdns.org

# ── ML & Speech Pipeline ─────────────────────────────────────────────────────
ENABLE_EAGER_WARMUP=true
ML_JOB_WORKERS=4
# Optional: set GROQ_API_KEY to use Groq Whisper API instead of local CPU Whisper
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ── Rate Limiting & Background Jobs ──────────────────────────────────────────
RATELIMIT_STORAGE=memory://
USE_CELERY=false

