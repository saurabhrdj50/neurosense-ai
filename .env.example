# =====================================================================
# NeuroSense AI — Full-Stack Master Environment Configuration
# Place a copy of this file as '.env' in the project root directory
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite / React)
# ---------------------------------------------------------------------
# Set to 'true' for standalone Vercel demo mode (mock data).
# Set to 'false' for local development with Python backend connected.
VITE_DEMO_MODE=false

# URL of the Python Flask backend REST API
VITE_API_URL=http://localhost:5000

# ---------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (Python / Flask / PyTorch AI)
# ---------------------------------------------------------------------
# Secret key used for session cookies and JWT authentication
SECRET_KEY=neurosense-dev-secret-key-change-in-production

# Server environment mode (development / production)
FLASK_ENV=development

# Backend REST API port
PORT=5000

# SQLite patient database path
DB_PATH=patient_data.db

# Path to trained PyTorch Alzheimer's MRI classifier model
MODEL_PATH=backend/app/models/alzheimer_model.pth
