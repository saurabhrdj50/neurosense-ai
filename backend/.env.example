# NeuroSense AI Backend Environment Variables

# Flask Core Configuration
SECRET_KEY=neurosense-dev-key-change-in-production
FLASK_ENV=production
PORT=10000
LOG_LEVEL=INFO

# Eager ML Warmup (Set 'false' to disable pre-loading heavy models into RAM on startup; conserves RAM on Render)
ENABLE_EAGER_WARMUP=false

# CORS Origins (Comma-separated allowed origins; *.vercel.app domains are automatically matched)
CORS_ORIGINS=https://neurosense-ai-eight.vercel.app,http://localhost:3000,http://localhost:5173

# Optional Rate Limiting Storage (memory:// by default; use redis://... in production if Redis is available)
RATELIMIT_STORAGE=memory://

# Optional External API Keys
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# SENTRY_DSN=your_sentry_dsn_here
