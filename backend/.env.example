# NeuroSense AI Backend Environment Variables

# Flask Core Configuration
# SECRET_KEY is REQUIRED in production — the app refuses to start without it.
SECRET_KEY=change-me-to-a-long-random-value
FLASK_ENV=production
PORT=10000
LOG_LEVEL=INFO

# Explicit feature flags (all default to the SAFE direction when unset)
# Seed the demo admin/doctor accounts with their public passwords:
SEED_DEMO_USERS=false
# Echo password-reset tokens in API responses (isolated dev/test only — no
# email delivery exists, so this is the only way to complete a reset locally):
EXPOSE_RESET_TOKEN=false
# Allow the speech fallback that uploads patient audio to Google's free web
# API (requires patient consent / no BAA — leave false in production):
ENABLE_GOOGLE_SPEECH_FALLBACK=false
# Set to true ONLY when running behind a reverse proxy (Render, nginx) so
# X-Forwarded-For is trusted for rate limiting and logs:
TRUST_PROXY=true

# Eager ML Warmup (Set 'false' to disable pre-loading heavy models into RAM on startup; conserves RAM on Render)
ENABLE_EAGER_WARMUP=false

# CORS Origins — explicit allowlist, comma-separated. There is NO wildcard
# subdomain matching anymore: list your exact frontend origin(s) here.
CORS_ORIGINS=https://neurosense-ai-eight.vercel.app,http://localhost:3000,http://localhost:5173

# Optional Rate Limiting Storage (memory:// by default = per-worker and reset
# on restart; use redis://... in production if Redis is available)
RATELIMIT_STORAGE=memory://

# Optional External Services
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_TRACES_SAMPLE_RATE=0.1
# APP_VERSION=1.0.0

# Optional Database (defaults to SQLite patient_data.db; set for PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/neurosense

# Session cookies.
# Cross-origin deployments (SPA on a different domain than the API) need
# SameSite=None + Secure=true, otherwise the browser will not attach the
# session cookie to cross-site fetch() calls and login silently fails:
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true   (defaults to true when FLASK_ENV=production)
# Persistent "remember me" cookie lifetime in days (default 30):
# REMEMBER_COOKIE_DAYS=30

# Optional Logging (text by default; set "json" for structured logs)
# LOG_FORMAT=text

# Test-only (do not set in production)
# TESTING=true
# SEED_DEMO_DATA=false
