# NeuroSense AI Backend Environment Variables (FastAPI + PostgreSQL stack)
# Copy to backend/.env and fill in. NEVER commit the filled-in file.

# Core Configuration
# SECRET_KEY is REQUIRED in production — the app refuses to start without it.
# It also derives the PHI field-encryption key: rotating it makes encrypted
# PHI unreadable, so treat it like a database credential, not a session secret.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Leave unset for local/plain-HTTP deployments (development defaults).
# Set to "production" ONLY when serving over HTTPS: production mode forces
# Secure session cookies, which silently break login on http://localhost.
# APP_ENV=production
PORT=10000
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL is the recommended store (docker-compose wires this automatically:
# the compose api service composes DATABASE_URL from the repo-root .env
# POSTGRES_* variables, so leave it unset here when running the Docker stack).
# Schema is versioned with Alembic: `alembic upgrade head` runs in the
# container entrypoint. One-time data import from a legacy SQLite file:
#   python scripts/migrate_sqlite_to_pg.py
# Set DATABASE_URL here ONLY for bare-metal PostgreSQL (host is the DB hostname):
# DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<dbname>
# If DATABASE_URL is unset the app falls back to a SQLite file at SQLITE_PATH
# (zero-config dev mode; also used by the test suite):
# SQLITE_PATH=/app/data/patient_data.db

# Explicit feature flags (all default to the SAFE direction when unset)
# No SEED_DEMO_USERS flag: the fixed admin (admin/admin) is always
# provisioned at startup and doctors self-register via /api/auth/register.
# Echo password-reset tokens in API responses (isolated dev/test only — no
# email delivery exists, so this is the only way to complete a reset locally):
EXPOSE_RESET_TOKEN=false
# Allow the speech fallback that uploads patient audio to Google's free web
# API (requires patient consent / no BAA — leave false in production):
# Speech transcription is fully local (faster-whisper); there is no third-party fallback.
# Set to true ONLY when running behind a reverse proxy (Render, nginx) so
# X-Forwarded-For is trusted for rate limiting and logs:
TRUST_PROXY=true

# Eager ML Warmup (Set 'false' to disable pre-loading heavy models into RAM on startup; conserves RAM on Render)
ENABLE_EAGER_WARMUP=false

# CORS Origins — explicit allowlist, comma-separated. There is NO wildcard
# subdomain matching: list your exact frontend origin(s). Not needed at all
# when the frontend is served behind the same nginx /api proxy (compose web).
CORS_ORIGINS=https://neurosense-ai-eight.vercel.app,http://localhost:3000,http://localhost:5173

# Optional Rate Limiting Storage (memory:// by default = per-process and reset
# on restart; use redis://... in production if Redis is available)
RATELIMIT_STORAGE=memory://
# Global default limits (per authenticated user, then per IP). Auth endpoints
# carry stricter fixed limits (login 10/min, register/reset 10/h, forgot 5/h).
# Offices behind one shared NAT share a user-keyed bucket — raise if needed:
# RATELIMIT_DEFAULT_LIMITS=2000/day,600/hour,120/minute

# Optional External Services
# SENTRY_DSN=your_sentry_dsn_here
# SENTRY_TRACES_SAMPLE_RATE=0.1
# APP_VERSION=1.0.0

# Session cookies (signed by SECRET_KEY; users re-login after key rotation).
# Cross-origin deployments (SPA on a different domain than the API) need
# SameSite=None + Secure=true, otherwise the browser will not attach the
# session cookie to cross-site fetch() calls and login silently fails:
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=true   (defaults to true when APP_ENV=production)
# Session lifetime in days (default 30):
# REMEMBER_COOKIE_DAYS=30

# Background ML jobs (analyze-async): thread pool size per process.
# Each worker may hold a Whisper model (~1.5GB) + ResNet (~45MB) in RAM.
# ML_JOB_WORKERS=2
# Whisper transcription model (default: base on CPU, turbo on GPU) and the
# maximum audio duration transcribed per clip, in seconds.
# WHISPER_MODEL=base
# WHISPER_MAX_AUDIO_SEC=120

# Speech NLP dementia classifier (research model over the transcript; fully
# local). Requires models/speech/distilbert_only_model.joblib and downloads
# the distilbert-base-uncased encoder (~268MB) into the HuggingFace cache on
# first load — point HF_HOME at a mounted volume in Docker.
# SPEECH_NLP_ENABLED=true
# Minimum transcript word count before the classifier runs (default 15):
# SPEECH_NLP_MIN_WORDS=15
# HF_HOME=/models/hf

# Optional Logging (text by default; set "json" for structured logs)
# LOG_FORMAT=text

# Host allowlist (comma-separated). Off by default ('*'); set in production to
# neutralize host-header injection, e.g.:
# TRUSTED_HOSTS=api.neurosense.example.com

# Optional Redis mirror for background-job state. Unset = memory-backed
# (correct for the single-process deployment). When set, job state survives
# API restarts and a future multi-worker setup can share it.
# REDIS_URL=redis://redis:6379/0

# Test-only (do not set in production)
# TESTING=true
# SEED_DEMO_DATA=false
# TEST_DATABASE_URL=postgresql://... (CI runs the suite against real Postgres)
