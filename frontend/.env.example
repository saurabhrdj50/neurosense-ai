# =====================================================================
# NeuroSense AI — Frontend Deployment Template (Vercel)
# =====================================================================
# Configure these variables in Vercel Project Settings:

# 1. URL of your live Render FastAPI backend:
#    (set this AFTER the Render service exists — the frontend is built
#    with this value baked in, so redeploy the frontend after changing it)
VITE_API_URL=https://<render-service>.onrender.com

# 2. Simplified (free-tier) deploy flags — set both to "false" in Vercel
#    for the demo deploy to hide the MRI and voice steps (the backend
#    enforces the same flags and answers 503 for those uploads).
#    Leave unset / "true" for a full local deploy.
# VITE_ENABLE_MRI=false
# VITE_ENABLE_VOICE=false
